# Replace the values below with the actual database connection details for your MariaDB database. 
DATABASE_URL="mysql://username:password@hostname:3306/database_name"
DATABASE_HOST="hostname"
DATABASE_PORT="3306"
DATABASE_USER="username"
DATABASE_PASSWORD="password"
DATABASE_NAME="database_name"

# These values shouldn't need to be modified.
NODE_ENV="production"
SERVER_PORT=5001

# Replace the value below with a long, random string. Will be used for authentication cryptography. 
JWT_SECRET="long-random-string"
JWT_EXPIRES_IN="15m"

# Replace URL:PORT with the actual URL and port of your frontend application.
FRONTEND_URL="URL:PORT" 